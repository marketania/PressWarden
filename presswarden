Omit the target for the configured fleet. A named site's directory includes discovered nested installs.
Examples: ./presswarden scan example.com   ./presswarden lock example.com   ./presswarden wp-settings example.com
List recognized names: ./presswarden sites
Portable installs automatically scan outside the PressWarden program folder.
EOF
}

resolve_root() {
  local explicit="${1:-}" c parent
  if [ -n "$explicit" ]; then
    c="$explicit"
  elif [ -n "${PRESSWARDEN_SCAN_ROOT:-}" ]; then
    c="$PRESSWARDEN_SCAN_ROOT"
  elif [ "$PRESSWARDEN_PORTABLE" = 1 ]; then
    parent=$(cd "$PRESSWARDEN_DIR/.." 2>/dev/null && pwd -P || dirname "$PRESSWARDEN_DIR")
    if [ -d "$parent/domains" ]; then c="$parent/domains"
    elif [ -d "$parent/public_html" ]; then c="$parent/public_html"
    else c="$parent"
    fi
  elif [ -d "$HOME/domains" ]; then c="$HOME/domains"
  elif [ -d "$HOME/public_html" ]; then c="$HOME/public_html"
  elif [ -d /var/www ]; then c=/var/www
  else c="$PWD"
  fi
  if command -v realpath >/dev/null 2>&1; then realpath "$c" 2>/dev/null || printf '%s' "$c"; else (cd "$c" 2>/dev/null && pwd -P) || printf '%s' "$c"; fi
}

# One resolver for every command accepting a site/directory. A failed name must
# never become an empty ROOT (which would silently broaden the operation).
select_target() {
  local target="${1:-}" result scope line kind value first
  [ "$#" -le 1 ] || { printf 'Use one website name, directory, or all.\n' >&2; return 2; }
  TARGET_NAME=''; TARGET_COUNT=''
  case "$target" in
    ''|all) ROOT=$(resolve_root '') ;;
    /*|./*|../*|.|..|~/*) ROOT=$(resolve_root "$target") ;;
    *)
      if [[ "$target" != *.* && "$target" != *://* ]] && [ -d "$target" ]; then
        ROOT=$(resolve_root "$target")
      else
        scope=$(resolve_root '')
        result=$(bash "$PRESSWARDEN_DIR/lib/site-target.sh" "$scope" "$target") || return 2
        first=${result%%$'\n'*}
        IFS=$'\t' read -r ROOT TARGET_NAME TARGET_COUNT <<< "$first"
        _PW_TARGET_EXCLUSIONS=''
        while IFS=$'\t' read -r kind value; do
          [ "$kind" != E ] || _PW_TARGET_EXCLUSIONS+="$value"$'\n'
        done <<< "$result"
        export _PW_TARGET_EXCLUSIONS
        [ -d "$ROOT" ] && [ -n "$TARGET_NAME" ] || return 2
        printf 'Target: %s' "$TARGET_NAME" >&2
        [ "${TARGET_COUNT:-1}" -le 1 ] || printf ' (%s installations, including nested sites)' "$TARGET_COUNT" >&2
        printf '\n' >&2
      fi ;;
  esac
  export ROOT PRESSWARDEN_DIR
}

show_config() {
  local r mode state cache intel baseline
  r=$(resolve_root '')
  if [ "$PRESSWARDEN_PORTABLE" = 1 ]; then
    mode='portable/local'
    state="${PRESSWARDEN_STATE_DIR:-$PRESSWARDEN_DIR/var}"
    cache="${PRESSWARDEN_CACHE_DIR:-$PRESSWARDEN_DIR/var/cache}"
  else
    mode='user/system'
    state="${PRESSWARDEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/presswarden}"
    cache="${PRESSWARDEN_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/presswarden}"
  fi
  intel="${PRESSWARDEN_INTEL_DIR:-$state/intel}"
  baseline="$state/baselines"
  printf 'PressWarden v%s\n\n' "$VERSION"
  printf 'Install mode:       %s\n' "$mode"
  printf 'Program directory:  %s\n' "$PRESSWARDEN_DIR"
  printf 'Config:             %s\n' "$CONFIG_FILE"
  printf 'Scan root:          %s\n' "$r"
  printf 'Discovery depth:    %s\n' "${PRESSWARDEN_DISCOVERY_DEPTH:-8}"
  printf 'Interactive:        %s\n' "${PRESSWARDEN_INTERACTIVE:-1}"
  printf 'JSON reports:       %s\n' "${PRESSWARDEN_OUTPUT_JSON:-1}"
  printf 'Deep upload scan:   %s\n' "${PRESSWARDEN_UPLOADS_DEEP:-ask in FULL/incident}"
  printf 'WPScan API:         %s\n' "$([ -n "${WPSCAN_API_TOKEN:-}" ] && printf configured || printf 'not configured')"
  printf 'Wordfence Intel:    %s\n' "$([ -n "${PRESSWARDEN_WORDFENCE_TOKEN:-}" ] && printf configured || printf 'not configured')"
  printf 'Patchstack Intel:   %s\n' "$([ -n "${PRESSWARDEN_PATCHSTACK_KEY:-}" ] && printf configured || printf 'not configured')"
  printf 'External YARA:      %s\n' "$([ -n "${PRESSWARDEN_YARA_RULES:-}" ] && printf configured || printf 'not configured')"
  printf 'Hostinger API:      %s\n' "$([ -n "${HOSTINGER_API_TOKEN:-}" ] && printf 'configured (optional)' || printf 'not configured')"
  printf 'State directory:    %s\n' "$state"
  printf 'Cache directory:    %s\n' "$cache"
  printf 'Intel directory:    %s\n' "$intel"
  printf 'Baseline directory: %s\n' "$baseline"
  printf 'Run-state directory:%s %s\n' ' ' "$state/runs"
}

confirm_fleet_file_mods() {
  local action="$1" root="$2" verb ans=''
  [ "$action" = on ] && verb='LOCK' || verb='UNLOCK'
  if [ "${PRESSWARDEN_INTERACTIVE:-1}" = "0" ]; then return 0; fi
  if [ -r /dev/tty ] && [ -w /dev/tty ]; then
    if [ -n "${TARGET_NAME:-}" ]; then
      printf '\n  %s %s (%s installation(s))? [y/N]: ' "$verb" "$TARGET_NAME" "${TARGET_COUNT:-1}" > /dev/tty
    else
      printf '\n  %s all discovered websites under %s? [y/N]: ' "$verb" "$root" > /dev/tty
    fi
    IFS= read -r ans < /dev/tty || ans=''
    case "$ans" in y|Y|yes|YES) return 0 ;; *) printf 'Cancelled.\n'; return 1 ;; esac
  fi
  printf 'Refusing fleet %s without an interactive terminal. Set PRESSWARDEN_INTERACTIVE=0 to run intentionally in automation.\n' "${verb,,}" >&2
  return 1
}

confirm_auto_update_change() {
  local area="$1" value="$2" root="$3" ans=''
  if [ "${PRESSWARDEN_INTERACTIVE:-1}" = "0" ]; then return 0; fi
  if [ -r /dev/tty ] && [ -w /dev/tty ]; then
    if [ -n "${TARGET_NAME:-}" ]; then
      printf '\n  Set %s auto-updates to %s for %s (%s installation(s))? [y/N]: ' "$area" "$value" "$TARGET_NAME" "${TARGET_COUNT:-1}" > /dev/tty
    else
      printf '\n  Set %s auto-updates to %s for all discovered websites under %s? [y/N]: ' "$area" "$value" "$root" > /dev/tty
    fi
    IFS= read -r ans < /dev/tty || ans=''
    case "$ans" in y|Y|yes|YES) return 0 ;; *) printf 'Cancelled.\n'; return 1 ;; esac
  fi
  printf 'Refusing fleet auto-update change without an interactive terminal. Set PRESSWARDEN_INTERACTIVE=0 to run intentionally in automation.\n' >&2
  return 1
}

confirm_wp_setting_change() {
  local setting="$1" value="$2" root="$3" ans=''
  if [ "${PRESSWARDEN_INTERACTIVE:-1}" = "0" ]; then return 0; fi
  if [ -r /dev/tty ] && [ -w /dev/tty ]; then
    if [ -n "${TARGET_NAME:-}" ]; then
      printf '\n  Set %s=%s for %s (%s installation(s))? [y/N]: ' "$setting" "$value" "$TARGET_NAME" "${TARGET_COUNT:-1}" > /dev/tty
    else
      printf '\n  Set %s=%s for all discovered websites under %s? [y/N]: ' "$setting" "$value" "$root" > /dev/tty
    fi
    IFS= read -r ans < /dev/tty || ans=''
    case "$ans" in y|Y|yes|YES) return 0 ;; *) printf 'Cancelled.\n'; return 1 ;; esac
  fi
  printf 'Refusing fleet wp-settings change without an interactive terminal. Set PRESSWARDEN_INTERACTIVE=0 to run intentionally in automation.\n' >&2
  return 1
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  -V|--version|version) printf 'PressWarden %s\n' "$VERSION" ;;
  help|-h|--help) usage ;;
  config) show_config ;;
  continue|resume)
    [ "$#" -le 1 ] || { printf 'Usage: ./presswarden continue [RUN_ID]\n' >&2; exit 2; }
    command -v php >/dev/null 2>&1 || { printf 'Safe continuation requires PHP CLI.\n' >&2; exit 2; }
    if [ "$PRESSWARDEN_PORTABLE" = 1 ]; then state="${PRESSWARDEN_STATE_DIR:-$PRESSWARDEN_DIR/var}"; else state="${PRESSWARDEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/presswarden}"; fi
    plan=$(php "$PRESSWARDEN_DIR/lib/run-continuation.php" plan "$state/runs" "${1:-latest}" "$VERSION") || exit 2
    parent=''; suite=''; root=''; depth=''; start=''; index=''; total=''; carried=''; _PW_TARGET_EXCLUSIONS=''
    while IFS=$'\t' read -r key value; do
      case "$key" in
        RUN) parent="$value" ;; SUITE) suite="$value" ;; ROOT) root="$value" ;; DEPTH) depth="$value" ;;
        START) start="$value" ;; INDEX) index="$value" ;; TOTAL) total="$value" ;; CARRY) carried="$value" ;;
        EXCLUDE) _PW_TARGET_EXCLUSIONS+="$value"$'\n' ;;
      esac
    done <<< "$plan"
    [ -n "$parent" ] && [ -n "$suite" ] && [ -n "$root" ] && [ -n "$start" ] || { printf 'INCOMPLETE: continuation plan is invalid.\n' >&2; exit 2; }
    ROOT="$root"; PRESSWARDEN_DISCOVERY_DEPTH="$depth"; PRESSWARDEN_CONTINUE_FROM="$parent"
    export ROOT PRESSWARDEN_DIR PRESSWARDEN_DISCOVERY_DEPTH PRESSWARDEN_CONTINUE_FROM _PW_TARGET_EXCLUSIONS
    printf 'Continuing %s run %s from [%s/%s] %s; carrying %s completed check(s).\n' "$suite" "$parent" "$index" "$total" "$start" "$carried" >&2
    case "$suite" in
      fast|full|incident|db) exec bash "$PRESSWARDEN_DIR/suites/$suite.sh" ;;
      intel) exec bash "$PRESSWARDEN_DIR/suites/intel.sh" ;;
      inspect-php) exec bash "$PRESSWARDEN_DIR/suites/inspect.sh" php ;;
      inspect-js) exec bash "$PRESSWARDEN_DIR/suites/inspect.sh" js ;;
      inspect-db) exec bash "$PRESSWARDEN_DIR/suites/inspect.sh" db ;;
      inspect-runtime) exec bash "$PRESSWARDEN_DIR/suites/inspect.sh" runtime ;;
      *) printf 'INCOMPLETE: suite is not continuation-enabled.\n' >&2; exit 2 ;;
    esac
    ;;
  last-run|run-status)
    if [ "$cmd" = last-run ]; then
      [ "$#" -eq 0 ] || { printf 'Usage: ./presswarden last-run\n' >&2; exit 2; }
      run_id=''
    else
      [ "$#" -le 1 ] || { printf 'Usage: ./presswarden run-status [RUN_ID]\n' >&2; exit 2; }
      run_id="${1:-}"
    fi
    command -v php >/dev/null 2>&1 || { printf 'Run-status inspection requires PHP CLI.\n' >&2; exit 2; }
    if [ "$PRESSWARDEN_PORTABLE" = 1 ]; then
      state="${PRESSWARDEN_STATE_DIR:-$PRESSWARDEN_DIR/var}"
    else
      state="${PRESSWARDEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/presswarden}"
    fi
    exec php "$PRESSWARDEN_DIR/lib/run-state.php" show "$state/runs" "$run_id"
    ;;
  history)
    [ "$#" -le 1 ] || { printf 'Usage: ./presswarden history [RUN_ID]\n' >&2; exit 2; }
    run_id="${1:-}"
    command -v php >/dev/null 2>&1 || { printf 'Finding-history inspection requires PHP CLI.\n' >&2; exit 2; }
    if [ "$PRESSWARDEN_PORTABLE" = 1 ]; then
      state="${PRESSWARDEN_STATE_DIR:-$PRESSWARDEN_DIR/var}"
    else
      state="${PRESSWARDEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/presswarden}"
    fi
    exec php "$PRESSWARDEN_DIR/lib/finding-history.php" show "$state/runs" "$run_id"
    ;;
  sites)
    [ "$#" -le 1 ] || { printf 'Usage: ./presswarden sites [directory]\n' >&2; exit 2; }
    ROOT=$(resolve_root "${1:-}")
    exec bash "$PRESSWARDEN_DIR/lib/site-target.sh" "$ROOT" --list
    ;;
  update)
    # shellcheck disable=SC1090
    . "$PRESSWARDEN_DIR/lib/update.sh"
    pw_update
    ;;
  quarantine)
    action="${1:-list}"; [ "$#" -gt 0 ] && shift || true
    case "$action" in
      list) [ "$#" -eq 0 ] || { printf 'Usage: ./presswarden quarantine list\n' >&2; exit 2; } ;;
      verify) [ "$#" -eq 1 ] || { printf 'Usage: ./presswarden quarantine verify CASE_ID\n' >&2; exit 2; } ;;
      *) printf 'Use quarantine list or quarantine verify CASE_ID. No restore/delete action is provided.\n' >&2; exit 2 ;;
    esac
    command -v php >/dev/null 2>&1 || { printf 'Quarantine inspection requires PHP CLI.\n' >&2; exit 2; }
    if [ "$PRESSWARDEN_PORTABLE" = 1 ]; then
      state="${PRESSWARDEN_STATE_DIR:-$PRESSWARDEN_DIR/var}"
    else
      state="${PRESSWARDEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/presswarden}"
    fi
    exec php "$PRESSWARDEN_DIR/lib/quarantine-cli.php" "$action" "${QUARANTINE:-$state/quarantine}" "$@"
    ;;
  inspect)
    kind="${1:-help}"; [ "$#" -gt 0 ] && shift || true
    case "$kind" in
      help|-h|--help)
        printf 'Usage: ./presswarden inspect php|js|db|runtime [website or directory]\n\n'
        printf 'php  PHP callable, credential and browser-payload intelligence only\n'
        printf 'js   JavaScript/inline HTML intelligence only\n'
        printf 'db   Database-stored threat intelligence only (no maintenance)\n'
        printf 'runtime  PHP environment (optional --details after target)\n\n'
        printf 'Use a website name or directory; omit it for the fleet. No feed refresh or remediation.\n'
        printf 'Not a full security audit. Database inspection still loads WordPress through WP-CLI.\n'
        exit 0 ;;
      php|js|db|runtime) : ;;
      *) printf 'Unknown inspect kind. Use php, js, db or runtime.\n' >&2; exit 2 ;;
    esac
    if [ "$kind" = runtime ] && [ "${*: -1}" = --details ]; then
      export PRESSWARDEN_PHP_DETAILS=1
      set -- "${@:1:$#-1}"
    fi
    [ "$#" -le 1 ] || { printf 'Too many inspect arguments; use one website or directory.\n' >&2; exit 2; }
    select_target "$@" || exit 2
    exec bash "$PRESSWARDEN_DIR/suites/inspect.sh" "$kind"
    ;;
  fast|scan|full|incident|db)
    select_target "$@" || exit 2
    suite="$cmd"; [ "$suite" = scan ] && suite=fast
    exec bash "$PRESSWARDEN_DIR/suites/$suite.sh"
    ;;
  litespeed)
    ls_target=''
    ls_args=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --target|--site)
          [ "$#" -ge 2 ] || { printf '%s requires a website, directory, or all.\n' "$1" >&2; exit 2; }
          [ -z "$ls_target" ] || { printf 'LiteSpeed target was supplied more than once. Use one positional target or one --target/--site value.\n' >&2; exit 2; }
          ls_target="$2"; shift 2 ;;
        --target=*|--site=*)
          [ -z "$ls_target" ] || { printf 'LiteSpeed target was supplied more than once. Use one positional target or one --target/--site value.\n' >&2; exit 2; }
          ls_target=${1#*=}; [ -n "$ls_target" ] || { printf 'LiteSpeed target cannot be empty.\n' >&2; exit 2; }; shift ;;
        *) ls_args+=("$1"); shift ;;
      esac
    done

    # LiteSpeed database actions have no ordinary positional operands after the
    # action name (only optional --blog=ID), so PressWarden can safely accept the
    # same positional website target used by the rest of the CLI.
    if [ "${ls_args[0]:-}" = database ] || [ "${ls_args[0]:-}" = db ]; then
      ls_db_area="${ls_args[0]}"
      ls_db_action="${ls_args[1]:-status}"
      ls_db_known=0
      case "$ls_db_action" in
        status|clear-posts|clear_posts|clear-comments|clear_comments|clear-trackbacks|clear_trackbacks|clear-transients|clear_transients|optimize-tables|optimize_tables|optimize-all|optimize_all|optimize) ls_db_known=1 ;;
      esac

      # `presswarden litespeed database example.com` means status for that site.
      if [ "$ls_db_known" -eq 0 ] && [ -z "$ls_target" ]; then
        case "$ls_db_action" in
          all|*.*|*/*|.|..|~/*)
            ls_target="$ls_db_action"
            ls_db_action=status
            ls_args=("$ls_db_area" "$ls_db_action")
            ls_db_known=1
            ;;
        esac
      fi

      if [ "$ls_db_known" -eq 1 ]; then
        ls_db_rest=()
        ls_i=2
        while [ "$ls_i" -lt "${#ls_args[@]}" ]; do
          ls_arg="${ls_args[$ls_i]}"
          case "$ls_arg" in
            --blog=*) ls_db_rest+=("$ls_arg") ;;
            --all|--*.*|--*/*)
              ls_bad_target=${ls_arg#--}
              printf 'Invalid PressWarden target syntax: %s\n' "$ls_arg" >&2
              printf 'Use one of these instead:\n' >&2
              printf '  ./presswarden litespeed database %s %s\n' "$ls_db_action" "$ls_bad_target" >&2
              printf '  ./presswarden litespeed database %s --target %s\n' "$ls_db_action" "$ls_bad_target" >&2
              exit 2
              ;;
            --*) ls_db_rest+=("$ls_arg") ;;
            *)
              [ -z "$ls_target" ] || { printf 'LiteSpeed database target was supplied more than once. Use one website/directory/all target.\n' >&2; exit 2; }
              ls_target="$ls_arg"
              ;;
          esac
          ls_i=$((ls_i+1))
        done
        ls_args=("$ls_db_area" "$ls_db_action" "${ls_db_rest[@]}")
      fi
    fi

    if [ -n "$ls_target" ]; then select_target "$ls_target" || exit 2; else select_target || exit 2; fi
    exec bash "$PRESSWARDEN_DIR/checks/litespeed.sh" "${ls_args[@]}"
    ;;
  litespeed-db)
    action="${1:-status}"; [ "$#" -gt 0 ] && shift || true
    case "$action" in
      status|optimize) : ;;
      optimize-all|optimize_all) action=optimize ;;
      *) printf 'PressWarden LiteSpeed DB action must be status or optimize.\n' >&2; printf 'Examples:\n  ./presswarden litespeed-db status example.com\n  ./presswarden litespeed-db optimize example.com\n' >&2; exit 2 ;;
    esac
    lsdb_target=''
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --target|--site)
          [ "$#" -ge 2 ] || { printf '%s requires a website, directory, or all.\n' "$1" >&2; exit 2; }
          [ -z "$lsdb_target" ] || { printf 'LiteSpeed DB target was supplied more than once.\n' >&2; exit 2; }
          lsdb_target="$2"; shift 2 ;;
        --target=*|--site=*)
          [ -z "$lsdb_target" ] || { printf 'LiteSpeed DB target was supplied more than once.\n' >&2; exit 2; }
          lsdb_target=${1#*=}; [ -n "$lsdb_target" ] || { printf 'LiteSpeed DB target cannot be empty.\n' >&2; exit 2; }; shift ;;
        --all|--*.*|--*/*)
          lsdb_bad=${1#--}
          printf 'Invalid PressWarden target syntax: %s\n' "$1" >&2
          printf 'Use one of these instead:\n' >&2
          printf '  ./presswarden litespeed-db %s %s\n' "$action" "$lsdb_bad" >&2
          printf '  ./presswarden litespeed-db %s --target %s\n' "$action" "$lsdb_bad" >&2
          exit 2
          ;;
        --*)
          printf 'Unknown PressWarden litespeed-db option: %s\n' "$1" >&2
          printf 'Use a positional target or --target SITE. Example: ./presswarden litespeed-db %s example.com\n' "$action" >&2
          exit 2
          ;;
        *)
          [ -z "$lsdb_target" ] || { printf 'LiteSpeed DB target was supplied more than once. Use one website, directory, or all.\n' >&2; exit 2; }
          lsdb_target="$1"; shift ;;
      esac
    done
    select_target "$lsdb_target" || exit 2
    exec bash "$PRESSWARDEN_DIR/checks/litespeed-db.sh" "$action"
    ;;
  intel)
    action="${1:-status}"; [ "$#" -gt 0 ] && shift || true
    # shellcheck disable=SC1090
    . "$PRESSWARDEN_DIR/lib/intel.sh"
    case "$action" in
      status) pw_intel_status ;;
      update) pw_intel_update ;;
      scan)
        select_target "$@" || exit 2
        exec bash "$PRESSWARDEN_DIR/suites/intel.sh"
        ;;
      *) printf 'Unknown intel action: %s (use status, update, or scan)\n' "$action" >&2; exit 2 ;;
    esac
    ;;
  baseline)
    action="${1:-status}"; [ "$#" -gt 0 ] && shift || true
    [ "$#" -le 1 ] || { printf 'Usage: ./presswarden baseline create|status|diff [path]\n' >&2; exit 2; }
    select_target "$@" || exit 2
    # shellcheck disable=SC1090
    . "$PRESSWARDEN_DIR/lib/baseline.sh"
    case "$action" in
      create) pw_baseline_create ;;
      status) pw_baseline_status ;;
      diff|check|compare) pw_baseline_diff ;;
      *) printf 'Unknown baseline action: %s (use create, status, or diff)\n' "$action" >&2; exit 2 ;;
    esac
    ;;
  changes)
    [ "$#" -le 1 ] || { printf 'Usage: ./presswarden changes [path]\n' >&2; exit 2; }
    select_target "$@" || exit 2
    # shellcheck disable=SC1090
    . "$PRESSWARDEN_DIR/lib/baseline.sh"
    pw_baseline_diff
    ;;
  correlate)
    select_target "$@" || exit 2
    exec bash "$PRESSWARDEN_DIR/checks/fleet-correlate.sh"
    ;;
  cleanup)
    select_target "$@" || exit 2
    exec bash "$PRESSWARDEN_DIR/checks/sensitive-files.sh"
    ;;
  doctor)
    select_target "$@" || exit 2
    exec bash "$PRESSWARDEN_DIR/checks/doctor.sh"
    ;;
  lock|unlock)
    select_target "$@" || exit 2
    action=on; [ "$cmd" = unlock ] && action=off
    confirm_fleet_file_mods "$action" "$ROOT" || exit 1
    export PRESSWARDEN_INTERACTIVE=0
    exec bash "$PRESSWARDEN_DIR/checks/file-mods.sh" "$action"
    ;;
  lock-status)
    select_target "$@" || exit 2
    exec bash "$PRESSWARDEN_DIR/checks/file-mods.sh" status
    ;;
  wp-settings)
    sub="${1:-status}"
    if [ "$sub" = status ]; then
      shift || true
      [ "$#" -le 1 ] || { printf 'Usage: ./presswarden wp-settings [website|directory|all]\n' >&2; exit 2; }
      select_target "$@" || exit 2
      exec bash "$PRESSWARDEN_DIR/checks/wp-settings.sh" status
    elif [ "$sub" = set ]; then
      shift || true
      setting="${1:-}"; value="${2:-}"; target="${3:-}"
      [ "$#" -ge 2 ] && [ "$#" -le 3 ] || { printf 'Usage: ./presswarden wp-settings set SETTING VALUE [website|directory|all]\n' >&2; exit 2; }
      case "$setting" in
        editor|cron|recovery|debug|force-ssl-admin|alternate-cron)
          case "$value" in enabled|disabled) : ;; *) printf '%s must be enabled or disabled.\n' "$setting" >&2; exit 2 ;; esac ;;
        environment)
          case "$value" in production|staging|development|local) : ;; *) printf 'environment must be production, staging, development, or local.\n' >&2; exit 2 ;; esac ;;
        development)
          case "$value" in disabled|core|plugin|theme|all) : ;; *) printf 'development must be disabled, core, plugin, theme, or all.\n' >&2; exit 2 ;; esac ;;
        *) printf 'Supported wp-settings setters: editor, cron, recovery, environment, development, debug, force-ssl-admin, alternate-cron.\n' >&2; exit 2 ;;
      esac
      if [ -n "$target" ]; then select_target "$target" || exit 2; else select_target || exit 2; fi
      confirm_wp_setting_change "$setting" "$value" "$ROOT" || exit 1
      export PRESSWARDEN_POLICY_APPLY=1 PRESSWARDEN_INTERACTIVE=0
      exec bash "$PRESSWARDEN_DIR/checks/wp-settings.sh" set "$setting" "$value"
    else
      [ "$#" -le 1 ] || { printf 'Usage: ./presswarden wp-settings [website|directory|all]\n' >&2; exit 2; }
      select_target "$@" || exit 2
      exec bash "$PRESSWARDEN_DIR/checks/wp-settings.sh" status
    fi
    ;;
  auto-updates|auto-update)
    area="${1:-status}"; [ "$#" -gt 0 ] && shift || true
    case "$area" in
      status)
        [ "$#" -le 1 ] || { printf 'Usage: ./presswarden auto-updates status [website|directory|all]\n' >&2; exit 2; }
        select_target "$@" || exit 2
        exec bash "$PRESSWARDEN_DIR/checks/wp-auto-updates.sh" status
        ;;
      core)
        value="${1:-}"; [ "$#" -gt 0 ] && shift || true
        case "$value" in minor|major|disabled) : ;; disable) value=disabled ;; *) printf 'Core policy must be minor, major, or disabled.\n' >&2; exit 2 ;; esac
        [ "$#" -le 1 ] || { printf 'Usage: ./presswarden auto-updates core minor|major|disabled [website|directory|all]\n' >&2; exit 2; }
        select_target "$@" || exit 2
        confirm_auto_update_change CORE "$value" "$ROOT" || exit 1
        export PRESSWARDEN_INTERACTIVE=0
        exec bash "$PRESSWARDEN_DIR/checks/wp-auto-updates.sh" core "$value"
        ;;
      plugins|themes)
        value="${1:-}"; [ "$#" -gt 0 ] && shift || true
        case "$value" in enable|disable) : ;; *) printf '%s policy must be enable or disable.\n' "$area" >&2; exit 2 ;; esac
        [ "$#" -le 1 ] || { printf 'Usage: ./presswarden auto-updates %s enable|disable [website|directory|all]\n' "$area" >&2; exit 2; }
        select_target "$@" || exit 2
        confirm_auto_update_change "${area^^}" "$value" "$ROOT" || exit 1
        export PRESSWARDEN_INTERACTIVE=0
        exec bash "$PRESSWARDEN_DIR/checks/wp-auto-updates.sh" "$area" "$value"
        ;;
      *) printf 'Use auto-updates status, core, plugins, or themes.\n' >&2; exit 2 ;;
    esac
    ;;
  file-mods)
    action="${1:-status}"; [ "$#" -gt 0 ] && shift || true
    select_target "$@" || exit 2
    exec bash "$PRESSWARDEN_DIR/checks/file-mods.sh" "$action"
    ;;
  database|litespeed-database)
    hint_target=''
    hint_action="${1:-status}"
    for hint_arg in "$@"; do
      case "$hint_arg" in
        --target=*|--site=*) hint_target=${hint_arg#*=} ;;
        --all|--*.*|--*/*) hint_target=${hint_arg#--} ;;
        all|*.*|*/*|.|..|~/*) hint_target="$hint_arg" ;;
      esac
    done
    printf 'PressWarden has no top-level "%s" command.\n' "$cmd" >&2
    printf 'Use PressWarden syntax instead:\n' >&2
    if [ "$hint_action" = status ]; then
      if [ -n "$hint_target" ]; then
        printf '  ./presswarden litespeed-db status %s\n' "$hint_target" >&2
        printf '  ./presswarden litespeed database status --target %s\n' "$hint_target" >&2
      else
        printf '  ./presswarden litespeed-db status [website|directory|all]\n' >&2
        printf '  ./presswarden litespeed database status --target SITE\n' >&2
      fi
    else
      if [ -n "$hint_target" ]; then
        printf '  ./presswarden litespeed-db optimize %s\n' "$hint_target" >&2
        printf '  ./presswarden litespeed database optimize-all --target %s\n' "$hint_target" >&2
        printf '  ./presswarden db %s    # full PressWarden DB security + maintenance suite\n' "$hint_target" >&2
      else
        printf '  ./presswarden litespeed-db optimize [website|directory|all]\n' >&2
        printf '  ./presswarden litespeed database optimize-all --target SITE\n' >&2
        printf '  ./presswarden db [website|directory|all]\n' >&2
      fi
    fi
    exit 2
    ;;
  *)
    printf 'Unknown PressWarden command: %s\n' "$cmd" >&2
    printf 'Run ./presswarden help to see valid PressWarden inputs.\n' >&2
    exit 2
    ;;
esac
