}

usage() {
  local topic="${1:-}"
  [ "$#" -le 1 ] || { printf 'Usage: presswarden help [all|scan|reports|remediate|setup]\n' >&2; return 2; }
  case "$topic" in
    all) usage_all; return ;;
    scan|fast|full|incident|db|inspect)
      printf '%s%sPressWarden scans%s — read-only security investigation\n' "$B" "$C" "$X"
      pw_cli_section 'Usage: presswarden scan [MODE] [website|directory|all]'
      pw_cli_row 'scan [target]' 'Routine security audit (default fast mode)'
      pw_cli_row 'scan --full [target]' 'Deep integrity, malware and vulnerability checks'
      pw_cli_row 'scan --incident [target]' 'Evidence-first compromise investigation'
      pw_cli_row 'scan -db [target]' 'Database threats, persistence and credential isolation'
      pw_cli_row 'scan --php [target]' 'Focused PHP threat intelligence'
      pw_cli_row 'scan --js [target]' 'Focused JavaScript / inline HTML intelligence'
      pw_cli_row 'scan --runtime [target]' 'Inert local PHP persistence configuration'
      printf '\nChoose one mode. --deep aliases --full; -db and --db are equivalent.\n'
      printf 'Use --target SITE instead of a positional target. Omission selects the configured fleet.\n'
      printf 'Unknown, empty, duplicate or ambiguous targets stop without scanning the fleet.\n'
      printf 'Legacy fast/full/incident/db/inspect commands still work. Scans never approve remediation.\n'
      ;;
    reports|status|last-run|run-status|history|continue|resume)
      pw_cli_section 'Reports and continuation'
      pw_cli_row 'status [RUN_ID]' 'Latest or selected run status; alias of run-status'
      pw_cli_row 'history [RUN_ID]' 'NEW / RECURRING / CHANGED / RESOLVED findings'
      pw_cli_row 'continue [RUN_ID]' 'Resume a validated compatible interrupted run'
      printf '\nINCOMPLETE runs need attention; use history to distinguish skipped work from resolved findings.\n'
      printf 'These inspect or continue saved security runs, not maintenance jobs.\n'
      ;;
    remediate|quarantine)
      pw_cli_section 'Evidence and explicit security remediation'
      pw_cli_row 'remediate core [target]' 'Interactive official-core integrity recovery'
      pw_cli_row 'remediate files [target]' 'Interactive file-threat investigation'
      pw_cli_row 'quarantine list' 'Inspect preserved evidence cases'
      pw_cli_row 'quarantine verify CASE_ID' 'Verify saved evidence integrity'
      pw_cli_row 'quarantine prune --older-than=DAYS' 'Preview old verified cases; add --apply to delete'
      printf '\nRemediation requires a terminal and confirmation; prompts default to skip.\n'
      ;;
    cleanup|litespeed|litespeed-db|database|litespeed-database)
      pw_cli_section 'Maintenance belongs to PressGarden'
      printf 'Use ./pressgarden cleanup [target] to preview all routine cleanup categories.\n'
      printf 'Use ./pressgarden cleanup -db [target] or -logs [target] to narrow that preview.\n'
      printf 'PressWarden preserves security evidence and never runs a sibling automatically.\n'
      ;;
    setup|sites|doctor|config|config-new|update|version)
      pw_cli_section 'Setup and updates'
      pw_cli_row 'sites [directory]' 'List discovered WordPress installations'
      pw_cli_row 'doctor [target]' 'Check dependencies and available scan coverage'
      pw_cli_row 'config / config-new' 'Inspect configuration or preview template additions'
      pw_cli_row 'update / version' 'Update this tool or print its installed version'
      printf '\nColor: --color=auto|always|never (or --no-color). NO_COLOR disables ANSI color.\n'
      ;;
    intel|baseline|changes|correlate)
      pw_cli_section 'Advanced security commands'
      pw_cli_row 'intel status|update|scan [target]' 'Inspect feeds, explicitly refresh, or scan'
      pw_cli_row 'baseline create|status|diff [target]' 'Manage or compare integrity baselines'
      pw_cli_row 'changes [target]' 'Compare against the saved baseline'
      pw_cli_row 'correlate [target]' 'Correlate security evidence across selected sites'
      ;;
    '')
      printf '\n%s%sPressWarden v%s%s — WordPress security\n' "$B" "$C" "$VERSION" "$X"
      pw_cli_section 'Everyday commands'
      pw_cli_row 'scan [target]' 'Routine security audit'
      pw_cli_row 'scan --full [target]' 'Deep scan; --incident for compromise investigation'
      pw_cli_row 'scan -db|--php|--js [target]' 'Focus on one area'
      pw_cli_row 'status / history / continue [RUN_ID]' 'Review results or continue an interrupted run'
      pw_cli_row 'sites / doctor [target]' 'Find sites or check readiness'
      pw_cli_row 'remediate core|files [target]' 'Explicit interactive recovery'
      pw_cli_section 'Help and setup'
      printf '  help scan     help reports     help remediate     help all\n'
      printf '  config        config-new       update             version\n'
      printf '\nTargets: website, directory, or all; --target SITE also works for scans.\n'
      printf 'Omitted target selects the configured fleet. Invalid or empty targets stop.\n'
      printf 'Read-only scans preserve evidence. Routine cleanup: ./pressgarden cleanup [target].\n'
      printf 'Color: --color=auto|always|never. All legacy commands remain in help all.\n\n'
      ;;
    *) printf 'Unknown help topic: %s. Use help all for the complete command list.\n' "$topic" >&2; return 2 ;;
  esac
}

resolve_root() {
  local explicit="${1:-}" c parent
  if [ -n "$explicit" ]; then
    c="$explicit"
  elif [ -n "${PRESSWARDEN_SCAN_ROOT:-}" ]; then
    c="$PRESSWARDEN_SCAN_ROOT"
  elif [ "$PRESSWARDEN_PORTABLE" = 1 ]; then
    parent=$(cd "$PRESSWARDEN_DIR/.." 2>/dev/null && pwd -P || dirname "$PRESSWARDEN_DIR")
    if [ -d "$parent/domains" ]; then c="$parent/domains"
    elif [ -d "$parent/public_html" ]; then c="$parent/public_html"
    else c="$parent"
    fi
  elif [ -d "$HOME/domains" ]; then c="$HOME/domains"
  elif [ -d "$HOME/public_html" ]; then c="$HOME/public_html"
  elif [ -d /var/www ]; then c=/var/www
  else c="$PWD"
  fi
  if command -v php >/dev/null 2>&1; then php "$PRESSWARDEN_DIR/lib/target-path.php" "$PWD" "$c" || return 2; fi
  if command -v realpath >/dev/null 2>&1; then realpath "$c" 2>/dev/null || printf '%s' "$c"; else (cd "$c" 2>/dev/null && pwd -P) || printf '%s' "$c"; fi
}

# One resolver for every command accepting a site/directory. A failed name must
# never become an empty ROOT (which would silently broaden the operation).
select_target() {
  local target result scope line kind value first
  pw_cli_target_arguments "$@" || return 2
  set -- "${PW_CLI_TARGET_ARGS[@]}"
  target="${1:-}"
  [ "$#" -eq 0 ] || [ -n "$target" ] || { printf 'Explicit target cannot be empty.\n' >&2; return 2; }
  [ -z "$target" ] || [ ! -L "$target" ] || { printf 'Symlink target refused.\n' >&2; return 2; }
  TARGET_NAME=''; TARGET_COUNT=''
  _PW_FLEET_ROOT=$(resolve_root '') || return 2
  export _PW_FLEET_ROOT
  case "$target" in
    ''|all) ROOT=$(resolve_root '') || return 2 ;;
    /*|./*|../*|.|..|~/*) ROOT=$(resolve_root "$target") || return 2 ;;
    *)
      if [[ "$target" != *.* && "$target" != *://* ]] && [ -d "$target" ]; then
        ROOT=$(resolve_root "$target") || return 2
      else
        scope=$(resolve_root '') || return 2
        result=$(bash "$PRESSWARDEN_DIR/lib/site-target.sh" "$scope" "$target") || return 2
        first=${result%%$'\n'*}
        IFS=$'\t' read -r ROOT TARGET_NAME TARGET_COUNT <<< "$first"
        _PW_TARGET_EXCLUSIONS=''
        while IFS=$'\t' read -r kind value; do
          [ "$kind" != E ] || _PW_TARGET_EXCLUSIONS+="$value"$'\n'
        done <<< "$result"
        export _PW_TARGET_EXCLUSIONS
        [ -d "$ROOT" ] && [ -n "$TARGET_NAME" ] || return 2
        printf 'Target: %s' "$TARGET_NAME" >&2
        [ "${TARGET_COUNT:-1}" -le 1 ] || printf ' (%s installations, including nested sites)' "$TARGET_COUNT" >&2
        printf '\n' >&2
      fi ;;
  esac
  export ROOT PRESSWARDEN_DIR
}

show_config() {
  local r mode state cache intel baseline reports
  r=$(resolve_root '') || return 2
  if [ "$PRESSWARDEN_PORTABLE" = 1 ]; then
    mode='portable/local'
    state="${PRESSWARDEN_STATE_DIR:-$PRESSWARDEN_DIR/var}"
    cache="${PRESSWARDEN_CACHE_DIR:-$PRESSWARDEN_DIR/var/cache}"
  else
    mode='user/system'
    state="${PRESSWARDEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/presswarden}"
    cache="${PRESSWARDEN_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/presswarden}"
  fi
  intel="${PRESSWARDEN_INTEL_DIR:-$state/intel}"
  baseline="$state/baselines"
  reports="${PRESSWARDEN_REPORTS_DIR:-$state/reports}"
  printf 'PressWarden v%s\n\n' "$VERSION"
  printf 'Install mode:       %s\n' "$mode"
  printf 'Program directory:  %s\n' "$PRESSWARDEN_DIR"
  printf 'Config:             %s\n' "$CONFIG_FILE"
  printf 'Scan root:          %s\n' "$r"
  printf 'Discovery depth:    %s\n' "${PRESSWARDEN_DISCOVERY_DEPTH:-8}"
  printf 'Interactive:        %s\n' "${PRESSWARDEN_INTERACTIVE:-1}"
  printf 'JSON reports:       %s\n' "${PRESSWARDEN_OUTPUT_JSON:-1}"
  printf 'Deep upload scan:   %s\n' "${PRESSWARDEN_UPLOADS_DEEP:-ask in FULL/incident}"
  printf 'WPScan API:         %s\n' "$([ -n "${WPSCAN_API_TOKEN:-}" ] && printf configured || printf 'not configured')"
  printf 'Wordfence Intel:    %s\n' "$([ -n "${PRESSWARDEN_WORDFENCE_TOKEN:-}" ] && printf configured || printf 'not configured')"
  printf 'Patchstack Intel:   %s\n' "$([ -n "${PRESSWARDEN_PATCHSTACK_KEY:-}" ] && printf configured || printf 'not configured')"
  printf 'External YARA:      %s\n' "$([ -n "${PRESSWARDEN_YARA_RULES:-}" ] && printf configured || printf 'not configured')"
  printf 'State directory:    %s\n' "$state"
  printf 'Reports directory:  %s\n' "$reports"
  printf 'Cache directory:    %s\n' "$cache"
  printf 'Intel directory:    %s\n' "$intel"
  printf 'Baseline directory: %s\n' "$baseline"
  printf 'Run-state directory:%s %s\n' ' ' "$state/runs"
}


export _PW_EXPLICIT_REMEDIATION=0
cmd="${1:-help}"; shift || true
# Run a security scan. In a terminal, when a check printed a remediation hint,
# offer the separate remediate files workflow after the whole scan and its reports
# finished. The scan itself never changes files; the default answer is No.
pw_scan_then_offer_remediation() {
  local offer rc ans
  if [ ! -t 0 ] || [ "${PRESSWARDEN_INTERACTIVE:-1}" = 0 ]; then exec bash "$@"; fi
  offer=$(mktemp "${TMPDIR:-/tmp}/presswarden-offer.XXXXXX") || exec bash "$@"
  _PW_REMEDIATION_OFFER_FILE="$offer" bash "$@"; rc=$?
  if [ ! -s "$offer" ]; then rm -f -- "$offer"; return "$rc"; fi
  printf '\nThis scan found items that remediate files can quarantine (checks: %s).\n' "$(sort -u "$offer" | paste -sd ' ' -)"
  rm -f -- "$offer"
  printf 'It reruns those checks and asks again per section before any change.\n'
  printf 'Remediate now? [y/N] '
  IFS= read -r ans || ans=''
  case "$ans" in
    y|Y|yes|YES) export _PW_EXPLICIT_REMEDIATION=1; exec bash "$PRESSWARDEN_DIR/suites/remediate-files.sh" ;;
    *) printf 'Skipped. No files changed.\n'; return "$rc" ;;
  esac
}

# Manual quarantine retention. Preview by default; --apply deletes only the
# previewed, complete and hash-verified cases after a typed terminal confirmation.
pw_quarantine_prune() {
  local root="$1" days='' apply=0 arg preview list kind id extra n=0 total=0 kept=0 ans rc
  shift
  for arg in "$@"; do
    case "$arg" in
      --older-than=*) days=${arg#*=} ;;
      --apply) apply=1 ;;
      *) printf 'Usage: ./presswarden quarantine prune --older-than=DAYS [--apply]\n' >&2; return 2 ;;
    esac
  done
  [[ "$days" =~ ^[1-9][0-9]{0,4}$ ]] || { printf 'Usage: ./presswarden quarantine prune --older-than=DAYS [--apply]\n' >&2; return 2; }
  preview=$(mktemp "${TMPDIR:-/tmp}/presswarden-prune.XXXXXX") || return 2
  list=$(mktemp "${TMPDIR:-/tmp}/presswarden-prune-ids.XXXXXX") || { rm -f -- "$preview"; return 2; }
  php "$PRESSWARDEN_DIR/lib/quarantine-cli.php" prune-preview "$root" "$days" > "$preview" || { rm -f -- "$preview" "$list"; return 2; }
  printf 'PressWarden quarantine retention preview (cases older than %s days)\n' "$days"
  while IFS=$'\t' read -r kind id extra; do
    case "$kind" in
      ELIGIBLE) n=$((n+1)); total=$((total+extra)); printf '  PRUNE  %s  %s bytes\n' "$id" "$extra"; printf '%s\n' "$id" >> "$list" ;;
      KEPT) kept=$((kept+1)); printf '  KEEP   %s  %s\n' "$id" "$extra" ;;
    esac
  done < "$preview"
  rm -f -- "$preview"
  printf 'Eligible: %s case(s), %s bytes of retained evidence. Kept: %s.\n' "$n" "$total" "$kept"
  if [ "$apply" -ne 1 ] || [ "$n" -eq 0 ]; then
    [ "$n" -eq 0 ] || printf 'PREVIEW: nothing deleted. Add --apply to delete these cases after confirmation.\n'
    rm -f -- "$list"; return 0
  fi
  [ -t 0 ] && [ "${PRESSWARDEN_INTERACTIVE:-1}" != 0 ] || { printf 'Quarantine pruning requires an interactive terminal; it never auto-approves.\n' >&2; rm -f -- "$list"; return 2; }
  printf 'Deleted evidence cannot be restored by PressWarden. Keep an offline copy if an incident is open.\n'
  printf 'Type prune to delete these %s case(s), anything else to skip: ' "$n"
  IFS= read -r ans || ans=''
  if [ "$ans" != prune ]; then printf 'SKIPPED: no cases deleted.\n'; rm -f -- "$list"; return 0; fi
  php "$PRESSWARDEN_DIR/lib/quarantine-cli.php" prune-apply "$root" "$days" "$list"; rc=$?
  rm -f -- "$list"
  return "$rc"
}

case "$cmd" in
  -V|--version|version)
    [ "$#" -eq 0 ] || { printf 'Usage: presswarden version\n' >&2; exit 2; }
    printf 'PressWarden %s\n' "$VERSION" ;;
  help|-h|--help) usage "$@" ;;
  config)
    [ "$#" -eq 0 ] || { printf 'Usage: presswarden config\n' >&2; exit 2; }
    show_config ;;
  continue|resume)
    [ "$#" -le 1 ] || { printf 'Usage: ./presswarden continue [RUN_ID]\n' >&2; exit 2; }
    [ "$#" -eq 0 ] || [ -n "$1" ] || { printf 'Run ID cannot be empty; omit it to select the latest run.\n' >&2; exit 2; }
    command -v php >/dev/null 2>&1 || { printf 'Safe continuation requires PHP CLI.\n' >&2; exit 2; }
    if [ "$PRESSWARDEN_PORTABLE" = 1 ]; then state="${PRESSWARDEN_STATE_DIR:-$PRESSWARDEN_DIR/var}"; else state="${PRESSWARDEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/presswarden}"; fi
    plan=$(php "$PRESSWARDEN_DIR/lib/run-continuation.php" plan "$state/runs" "${1:-latest}" "$VERSION") || exit 2
    parent=''; suite=''; root=''; depth=''; start=''; index=''; total=''; carried=''; _PW_TARGET_EXCLUSIONS=''
    while IFS=$'\t' read -r key value; do
      case "$key" in
        RUN) parent="$value" ;; SUITE) suite="$value" ;; ROOT) root="$value" ;; DEPTH) depth="$value" ;;
        START) start="$value" ;; INDEX) index="$value" ;; TOTAL) total="$value" ;; CARRY) carried="$value" ;;
        EXCLUDE) _PW_TARGET_EXCLUSIONS+="$value"$'\n' ;;
      esac
    done <<< "$plan"
    [ -n "$parent" ] && [ -n "$suite" ] && [ -n "$root" ] && [ -n "$start" ] || { printf 'INCOMPLETE: continuation plan is invalid.\n' >&2; exit 2; }
    ROOT="$root"; PRESSWARDEN_DISCOVERY_DEPTH="$depth"; PRESSWARDEN_CONTINUE_FROM="$parent"
    export ROOT PRESSWARDEN_DIR PRESSWARDEN_DISCOVERY_DEPTH PRESSWARDEN_CONTINUE_FROM _PW_TARGET_EXCLUSIONS
    printf 'Continuing %s run %s from [%s/%s] %s; carrying %s completed check(s).\n' "$suite" "$parent" "$index" "$total" "$start" "$carried" >&2
    case "$suite" in
      fast|full|incident|db) exec bash "$PRESSWARDEN_DIR/suites/$suite.sh" ;;
      intel) exec bash "$PRESSWARDEN_DIR/suites/intel.sh" ;;
      inspect-php) exec bash "$PRESSWARDEN_DIR/suites/inspect.sh" php ;;
      inspect-js) exec bash "$PRESSWARDEN_DIR/suites/inspect.sh" js ;;
      inspect-db) exec bash "$PRESSWARDEN_DIR/suites/inspect.sh" db ;;
      inspect-runtime) exec bash "$PRESSWARDEN_DIR/suites/inspect.sh" runtime ;;
      *) printf 'INCOMPLETE: suite is not continuation-enabled.\n' >&2; exit 2 ;;
    esac
    ;;
  status|last-run|run-status)
    if [ "$cmd" = last-run ]; then
      [ "$#" -eq 0 ] || { printf 'Usage: ./presswarden last-run\n' >&2; exit 2; }
      run_id=''
    else
      [ "$#" -le 1 ] || { printf 'Usage: ./presswarden run-status [RUN_ID]\n' >&2; exit 2; }
      [ "$#" -eq 0 ] || [ -n "$1" ] || { printf 'Run ID cannot be empty; omit it to inspect the latest run.\n' >&2; exit 2; }
      run_id="${1:-}"
    fi
    command -v php >/dev/null 2>&1 || { printf 'Run-status inspection requires PHP CLI.\n' >&2; exit 2; }
    if [ "$PRESSWARDEN_PORTABLE" = 1 ]; then
      state="${PRESSWARDEN_STATE_DIR:-$PRESSWARDEN_DIR/var}"
    else
      state="${PRESSWARDEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/presswarden}"
    fi
    exec php "$PRESSWARDEN_DIR/lib/run-state.php" show "$state/runs" "$run_id"
    ;;
  history)
    [ "$#" -le 1 ] || { printf 'Usage: ./presswarden history [RUN_ID]\n' >&2; exit 2; }
    [ "$#" -eq 0 ] || [ -n "$1" ] || { printf 'Run ID cannot be empty; omit it to inspect the latest run.\n' >&2; exit 2; }
    run_id="${1:-}"
    command -v php >/dev/null 2>&1 || { printf 'Finding-history inspection requires PHP CLI.\n' >&2; exit 2; }
    if [ "$PRESSWARDEN_PORTABLE" = 1 ]; then
      state="${PRESSWARDEN_STATE_DIR:-$PRESSWARDEN_DIR/var}"
    else
      state="${PRESSWARDEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/presswarden}"
    fi
    exec php "$PRESSWARDEN_DIR/lib/finding-history.php" show "$state/runs" "$run_id"
    ;;
  sites)
    [ "$#" -le 1 ] || { printf 'Usage: ./presswarden sites [directory]\n' >&2; exit 2; }
    [ "$#" -eq 0 ] || [ -n "$1" ] || { printf 'Explicit target cannot be empty.\n' >&2; exit 2; }
    _PW_FLEET_ROOT=$(resolve_root '') || exit 2
    export _PW_FLEET_ROOT
    ROOT=$(resolve_root "${1:-}") || exit 2
    exec bash "$PRESSWARDEN_DIR/lib/site-target.sh" "$ROOT" --list
    ;;
  update)
    [ "$#" -eq 0 ] || { printf 'Usage: presswarden update\n' >&2; exit 2; }
    # shellcheck disable=SC1090
    . "$PRESSWARDEN_DIR/lib/update.sh"
    pw_update
    ;;
  quarantine)
    action="${1:-list}"; [ "$#" -gt 0 ] && shift || true
    case "$action" in
      list) [ "$#" -eq 0 ] || { printf 'Usage: ./presswarden quarantine list\n' >&2; exit 2; } ;;
      verify) [ "$#" -eq 1 ] || { printf 'Usage: ./presswarden quarantine verify CASE_ID\n' >&2; exit 2; } ;;
      prune) : ;;
      *) printf 'Use quarantine list, quarantine verify CASE_ID or quarantine prune --older-than=DAYS [--apply]. No restore action is provided.\n' >&2; exit 2 ;;
    esac
    command -v php >/dev/null 2>&1 || { printf 'Quarantine inspection requires PHP CLI.\n' >&2; exit 2; }
    if [ "$PRESSWARDEN_PORTABLE" = 1 ]; then
      state="${PRESSWARDEN_STATE_DIR:-$PRESSWARDEN_DIR/var}"
    else
      state="${PRESSWARDEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/presswarden}"
    fi
    if [ "$action" = prune ]; then
      pw_quarantine_prune "${QUARANTINE:-$state/quarantine}" "$@"; exit $?
    fi
    exec php "$PRESSWARDEN_DIR/lib/quarantine-cli.php" "$action" "${QUARANTINE:-$state/quarantine}" "$@"
    ;;
  inspect)
    kind="${1:-help}"; [ "$#" -gt 0 ] && shift || true
    case "$kind" in
      help|-h|--help)
        printf 'Usage: ./presswarden inspect php|js|db|runtime [website or directory]\n\n'
        printf 'php  PHP callable, credential and browser-payload intelligence only\n'
        printf 'js   JavaScript/inline HTML intelligence only\n'
        printf 'db   Database-stored threat intelligence only (no maintenance)\n'
        printf 'runtime  PHP environment (optional --details after target)\n\n'
        printf 'Use a website name or directory; omit it for the fleet. No feed refresh or remediation.\n'
        printf 'Not a full security audit. Database inspection still loads WordPress through WP-CLI.\n'
        exit 0 ;;
      php|js|db|runtime) : ;;
      *) printf 'Unknown inspect kind. Use php, js, db or runtime.\n' >&2; exit 2 ;;
    esac
    if [ "$kind" = runtime ] && [ "${*: -1}" = --details ]; then
      printf 'Detailed PHP policy belongs to: pressharden php inspect [target] --details. Running the local persistence check only.\n' >&2
      set -- "${@:1:$#-1}"
    fi
    select_target "$@" || exit 2
    exec bash "$PRESSWARDEN_DIR/suites/inspect.sh" "$kind"
    ;;
  scan)
    pw_cli_scan_arguments "$@"; rc=$?
    if [ "$rc" -eq 3 ]; then usage scan; exit 0; fi
    [ "$rc" -eq 0 ] || exit "$rc"
    select_target -- "${PW_CLI_TARGET_ARGS[@]}" || exit 2
    if [ "$PW_CLI_SCAN_SUITE" = inspect ]; then exec bash "$PRESSWARDEN_DIR/suites/inspect.sh" "$PW_CLI_SCAN_KIND"; fi
    pw_scan_then_offer_remediation "$PRESSWARDEN_DIR/suites/$PW_CLI_SCAN_SUITE.sh"; exit $?
    ;;
  fast|full|incident|db)
    select_target "$@" || exit 2
    pw_scan_then_offer_remediation "$PRESSWARDEN_DIR/suites/$cmd.sh"; exit $?
    ;;
  intel)
    action="${1:-status}"; [ "$#" -gt 0 ] && shift || true
    case "$action" in
      status|update) [ "$#" -eq 0 ] || { printf 'intel %s does not take a website or extra arguments.\n' "$action" >&2; exit 2; } ;;
    esac
    # shellcheck disable=SC1090
    . "$PRESSWARDEN_DIR/lib/intel.sh"
    case "$action" in
      status) pw_intel_status ;;
      update) pw_intel_update ;;
      scan)
        select_target "$@" || exit 2
        exec bash "$PRESSWARDEN_DIR/suites/intel.sh"
        ;;
      *) printf 'Unknown intel action: %s (use status, update, or scan)\n' "$action" >&2; exit 2 ;;
    esac
    ;;
  baseline)
    action="${1:-status}"; [ "$#" -gt 0 ] && shift || true
    select_target "$@" || exit 2
    # shellcheck disable=SC1090
    . "$PRESSWARDEN_DIR/lib/baseline.sh"
    case "$action" in
      create) pw_baseline_create ;;
      status) pw_baseline_status ;;
      diff|check|compare) pw_baseline_diff ;;
      *) printf 'Unknown baseline action: %s (use create, status, or diff)\n' "$action" >&2; exit 2 ;;
    esac
    ;;
  changes)
    select_target "$@" || exit 2
    # shellcheck disable=SC1090
    . "$PRESSWARDEN_DIR/lib/baseline.sh"
    pw_baseline_diff
    ;;
  correlate)
    select_target "$@" || exit 2
    exec bash "$PRESSWARDEN_DIR/checks/fleet-correlate.sh"
    ;;
  doctor)
    select_target "$@" || exit 2
    exec bash "$PRESSWARDEN_DIR/checks/doctor.sh"
    ;;
  lock|unlock|lock-status|wp-settings|auto-updates|auto-update|file-mods)
    printf 'This configuration command moved to PressHarden.\nUse: ./pressharden %s' "$cmd" >&2
    printf ' %q' "$@" >&2; printf '\nNo sibling was executed; no website changed.\n' >&2; exit 2 ;;
  cleanup|litespeed|litespeed-db)
    printf 'This maintenance command moved to PressGarden.\nUse: ./pressgarden %s' "$cmd" >&2
    printf ' %q' "$@" >&2; printf '\nNo sibling was executed; no website changed.\n' >&2; exit 2 ;;
  database|litespeed-database)
    printf 'Use ./presswarden db for database threats, or ./pressgarden db / litespeed-db for maintenance.\n' >&2; exit 2 ;;
  remediate)
    kind="${1:-}"; [ "$#" -gt 0 ] && shift || true
    case "$kind" in core|files) :;; *) printf 'Usage: presswarden remediate core|files [target]\n' >&2; exit 2;; esac
    select_target "$@" || exit 2
    [ -t 0 ] && [ "${PRESSWARDEN_INTERACTIVE:-1}" != 0 ] || { printf 'Security remediation requires an interactive terminal; it never auto-approves.\n' >&2; exit 2; }
    export _PW_EXPLICIT_REMEDIATION=1
    if [ "$kind" = core ]; then exec bash "$PRESSWARDEN_DIR/checks/wp-core.sh"; fi
    exec bash "$PRESSWARDEN_DIR/suites/remediate-files.sh"
    ;;
  *) printf 'Unknown PressWarden command: %s\nRun ./presswarden help for valid inputs.\n' "$cmd" >&2; exit 2 ;;
esac
