# PressWarden configuration
# Portable install: PressWarden/config/config
# User install: ~/.config/presswarden/config
# Keep this file private (chmod 600) if it contains API tokens.
# Exported environment variables override values from this file.

# Discovery. Empty means the CLI auto-detects a sensible root or uses the path argument.
PRESSWARDEN_SCAN_ROOT=""
PRESSWARDEN_DISCOVERY_DEPTH=8
PRESSWARDEN_EXCLUDE=""
PRESSWARDEN_DISCOVERY_CACHE_TTL=300

# Interaction / reports
PRESSWARDEN_INTERACTIVE=1
PRESSWARDEN_ADMINS_CHECK=""
PRESSWARDEN_OUTPUT_JSON=1
# Maximum baseline changes printed to the terminal. Full TSV diff is still saved to reports.
PRESSWARDEN_BASELINE_MAX_CHANGES=100
# Slow image-extension PHP scan in FULL: empty=ask, 1=always run, 0=always skip.
PRESSWARDEN_UPLOADS_DEEP=""
# PRESSWARDEN_NOCOLOR=1

# Network/cache tuning
PRESSWARDEN_PHP_RELEASE_CACHE_TTL=86400
PRESSWARDEN_WPORG_PLUGIN_CACHE_TTL=86400
PRESSWARDEN_HOSTINGER_PHP_CACHE_TTL=21600
PRESSWARDEN_HOSTINGER_API_JOBS=3

# Threat intelligence
PRESSWARDEN_INTEL_AUTO_UPDATE=1
PRESSWARDEN_INTEL_CISA=1
PRESSWARDEN_PATCHSTACK_CACHE_TTL=21600
PRESSWARDEN_PATCHSTACK_MAX_LOOKUPS=250
# Optional administrator-supplied YARA rule file. PressWarden ships no YARA signatures.
PRESSWARDEN_YARA_RULES=""
# Optional override for intel cache location; portable default is PressWarden/var/intel.
# PRESSWARDEN_INTEL_DIR=""

# Targeted database malware scan: candidate rows per source and total value bytes per site.
# Row values above 1 MiB are not fetched. Reaching a limit reports INCOMPLETE.
PRESSWARDEN_DB_MAX_ROWS=5000
PRESSWARDEN_DB_MAX_BYTES=33554432

# Optional vulnerability/provider integrations. Never commit real tokens.
WPSCAN_API_TOKEN=""
PRESSWARDEN_WORDFENCE_TOKEN=""
PRESSWARDEN_PATCHSTACK_KEY=""
HOSTINGER_API_TOKEN=""
PRESSWARDEN_HOSTINGER_USERNAME=""
